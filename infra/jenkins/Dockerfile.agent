FROM maven:3.9.11-eclipse-temurin-17 AS build_java
FROM node:22-bookworm-slim AS node
FROM hashicorp/terraform:1.15.1 AS terraform
FROM alpine/helm:3.19.0 AS helm

FROM jenkins/inbound-agent:latest

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates libatomic1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build_java /opt/java/openjdk /opt/java/build-jdk17
COPY --from=build_java /usr/share/maven /opt/maven
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=terraform /bin/terraform /usr/local/bin/terraform
COPY --from=helm /usr/bin/helm /usr/local/bin/helm

RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s /opt/maven/bin/mvn /usr/local/bin/mvn

# Run Jenkins remoting with the agent image's Java; build this project with Java 17.
ENV JENKINS_JAVA_BIN=/opt/java/openjdk/bin/java \
    JAVA_HOME=/opt/java/build-jdk17 \
    MAVEN_HOME=/opt/maven \
    PATH=/opt/java/build-jdk17/bin:/opt/maven/bin:/usr/local/bin:/usr/bin:/bin

USER jenkins
WORKDIR /home/jenkins/agent
